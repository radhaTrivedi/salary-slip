# Copy this file to .env and fill in your own values

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/salary_system

# Or MongoDB Atlas (replace with your own connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/salary_system

PORT=5000

# Used to sign login tokens. Change this to any long random string of your own.
JWT_SECRET=change-this-to-a-long-random-string
